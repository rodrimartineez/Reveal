<Window x:Class="Reveal.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reveal" Width="860" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Assets/reveal.ico">
    <!-- Everything fits in one view: the window sizes itself to its content (no scrolling). -->
    <Grid Margin="24,18,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="REVEAL" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Windows Vocabulary Companion" Style="{StaticResource Caption}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="StatusPill" CornerRadius="12" Padding="11,5" VerticalAlignment="Center" Background="{DynamicResource Bg2}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Text3}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLabel" Text="En pausa" FontSize="12" Margin="8,0,0,0" Foreground="{DynamicResource Text2}" />
                    </StackPanel>
                </Border>
                <Button x:Name="SettingsButton" Style="{StaticResource GhostButton}" Padding="10,6" ToolTip="Ajustes">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconGear}" Stroke="{DynamicResource Text2}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Ajustes" Margin="7,0,0,0" FontSize="12.5" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="QuitButton" Style="{StaticResource DangerGhostButton}" Padding="8" Margin="2,0,-8,0" ToolTip="Salir de Reveal">
                    <Path Data="{StaticResource IconPower}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Capture hero -->
            <Border Style="{StaticResource Card}" Padding="22,24,22,20" Background="{DynamicResource HeroBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ToggleButton x:Name="CaptureToggle" Style="{StaticResource PowerOrb}" HorizontalAlignment="Center"
                                  ToolTip="Activar o pausar la captura de selección" />
                    <TextBlock x:Name="HeroTitle" Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0"
                               FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" Text="Reveal está en pausa" />
                    <TextBlock x:Name="CaptureHint" Grid.Row="2" Style="{StaticResource Body}" FontSize="12.5" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="6,6,6,0" MaxWidth="280" />

                    <!-- Shortcuts: discreet chips; click one to change it -->
                    <StackPanel Grid.Row="4" Margin="0,18,0,0">
                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartKeyButton" Style="{StaticResource KeyChip}" ToolTip="Atajo para activar Reveal · clic para cambiarlo. Ojo: Ctrl+Shift+T también es «reabrir pestaña cerrada» en los navegadores; mientras Reveal está abierto, ese atajo es de Reveal.">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L7,4.5 L0,9 Z" Fill="{DynamicResource Success}" Width="7" Height="9" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StartKeyText" Style="{StaticResource KeyCaps}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopKeyButton" Grid.Column="2" Style="{StaticResource KeyChip}" ToolTip="Atajo para detener Reveal · clic para cambiarlo">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Fill="{DynamicResource Danger}" Width="8" Height="8" RadiusX="1.5" RadiusY="1.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StopKeyText" Style="{StaticResource KeyCaps}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="HotkeyMessage" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Configuration -->
            <StackPanel Grid.Column="2">

                <!-- Offline translation pack (only while it is missing) -->
                <Border x:Name="PackCard" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,0,12" BorderBrush="{DynamicResource AccentDim}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconDownload}" Style="{StaticResource CardIcon}" VerticalAlignment="Top" Margin="0,2,10,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Traducción sin conexión" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="PackText" Style="{StaticResource Body}" FontSize="12" Margin="0,3,12,0" />
                            </StackPanel>
                            <Button x:Name="PackButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Content="Descargar" />
                        </Grid>
                        <ProgressBar x:Name="PackProgress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Minimum="0" Maximum="1"
                                     Background="{DynamicResource Bg3}" Foreground="{DynamicResource Accent}" BorderThickness="0" />
                    </StackPanel>
                </Border>

                <!-- Vocabulary document -->
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" ToolTip="Cada palabra que guardes se añade al final de este archivo .docx. Nunca se sobrescribe nada.">
                            <Path Data="{StaticResource IconBookmark}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="Documento de vocabulario" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <Border Background="{DynamicResource Bg2}" CornerRadius="11" Padding="12,9" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource Text3}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"
                                      StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock x:Name="DocPath" Grid.Column="1" Margin="10,0,0,0" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DocStatus" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="OpenDocButton" Content="Abrir" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,0,4,0" />
                                <Button x:Name="NewDocButton" Content="Crear nuevo…" Style="{StaticResource BaseButton}" Padding="11,6" Margin="0,0,6,0" />
                                <Button x:Name="ChooseDocButton" Content="Elegir…" Style="{StaticResource BaseButton}" Padding="11,6" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Voices -->
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSpeaker}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="Pronunciación" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Voces de Windows · sin conexión" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Badge}" ToolTip="American English">
                                <TextBlock Text="US" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ComboBox x:Name="AmericanCombo" Grid.Column="1" />
                            <Button x:Name="AmericanTest" Grid.Column="2" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Width="38" Padding="0" Height="34" ToolTip="Probar voz americana">
                                <Path Data="{StaticResource IconSpeaker}" Stroke="{DynamicResource Text1}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Badge}" ToolTip="British English">
                                <TextBlock Text="UK" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ComboBox x:Name="BritishCombo" Grid.Column="1" />
                            <Button x:Name="BritishTest" Grid.Column="2" Style="{StaticResource BaseButton}" Margin="8,0,0,0" Width="38" Padding="0" Height="34" ToolTip="Probar voz británica">
                                <Path Data="{StaticResource IconSpeaker}" Stroke="{DynamicResource Text1}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                        </Grid>
                        <Grid x:Name="VoiceHelp" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VoiceHelpText" Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{DynamicResource Warning}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="OpenSpeechSettings" Grid.Column="1" Content="Ajustes de voz" Style="{StaticResource BaseButton}" Padding="11,6" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Recent lookups (memory only): save a word later -->
                <Border Style="{StaticResource Card}" Padding="16,12,16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" ToolTip="Solo se recuerdan mientras Reveal está abierto; nunca se guardan en el disco.">
                                <Path Data="{StaticResource IconHistory}" Style="{StaticResource CardIcon}" />
                                <TextBlock Text="Recientes" Style="{StaticResource CardTitle}" />
                            </StackPanel>
                            <Button x:Name="HistoryClear" Grid.Column="1" Content="Borrar" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="11.5"
                                    Margin="0,-4,-8,-4" ToolTip="Olvidar las consultas recientes" />
                        </Grid>
                        <StackPanel x:Name="HistoryList" Margin="-8,6,-8,0" />
                        <TextBlock x:Name="HistoryEmpty" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,2"
                                   Text="Las palabras que consultes aparecerán aquí para guardarlas más tarde." />
                        <TextBlock x:Name="HistoryMessage" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Warning}" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
