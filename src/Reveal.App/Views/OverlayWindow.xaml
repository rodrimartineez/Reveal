<Window x:Class="Reveal.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reveal" Width="404" SizeToContent="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <Style x:Key="VoiceButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Bg2}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                CornerRadius="12" Padding="11,7">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="Ico" Data="{StaticResource IconSpeaker}" Stroke="{DynamicResource Text2}" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg3}" />
                                <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="playing">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Ico" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="missing">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Border x:Name="Card" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource OverlayEdge}" BorderThickness="1" CornerRadius="20" Padding="18,16,18,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Headword + close -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeadwordText" FontFamily="{StaticResource DisplayFont}" FontSize="23" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text1}" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="24" Height="24" Padding="5"
                            VerticalAlignment="Top" Margin="8,-2,-6,0" ToolTip="Cerrar (Esc)" Focusable="False">
                        <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource Text3}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- IPA / part of speech -->
                <TextBlock x:Name="PhoneticsText" Grid.Row="1" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Text3}" Visibility="Collapsed" TextWrapping="Wrap" />

                <!-- Translation -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <TextBlock x:Name="TranslationText" FontSize="16" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" LineHeight="22" />
                    <TextBlock x:Name="PendingText" Text="Traduciendo…" FontSize="13" Foreground="{DynamicResource Text3}" Visibility="Collapsed" />
                </Grid>

                <!-- Pronunciation -->
                <WrapPanel x:Name="VoicePanel" Grid.Row="3" Margin="0,14,0,0">
                    <Button x:Name="AmericanButton" Style="{StaticResource VoiceButton}" Margin="0,0,8,0">
                        <TextBlock Text="American English" FontSize="12.5" Foreground="{DynamicResource Text1}" />
                    </Button>
                    <Button x:Name="BritishButton" Style="{StaticResource VoiceButton}">
                        <TextBlock Text="British English" FontSize="12.5" Foreground="{DynamicResource Text1}" />
                    </Button>
                </WrapPanel>

                <!-- Synonyms + example -->
                <StackPanel x:Name="SynonymsPanel" Grid.Row="4" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="SYNONYMS" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="SynonymsText" Margin="0,5,0,0" FontSize="13.5" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>

                <StackPanel x:Name="ExamplePanel" Grid.Row="5" Margin="0,14,0,0" Visibility="Collapsed">
                    <TextBlock Text="EXAMPLE" Style="{StaticResource SectionLabel}" />
                    <TextBlock x:Name="ExampleText" Margin="0,5,0,0" FontSize="13.5" Foreground="{DynamicResource Text2}" FontStyle="Italic" TextWrapping="Wrap" LineHeight="20" />
                </StackPanel>

                <!-- Footer -->
                <Grid Grid.Row="6" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SwapButton" Style="{StaticResource GhostButton}" Padding="8,5" Margin="-8,0,6,0" Visibility="Collapsed" Focusable="False"
                                ToolTip="Interpretar la selección en el otro idioma">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSwap}" Stroke="{DynamicResource Text2}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock x:Name="SwapText" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource Text2}" />
                            </StackPanel>
                        </Button>
                        <Path x:Name="StatusIcon" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Visibility="Collapsed" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource Text3}" TextWrapping="Wrap" MaxWidth="190" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="12,7" Focusable="False" ToolTip="Guardar en tu documento de vocabulario">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="SaveIcon" Data="{StaticResource IconBookmark}" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.9" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock x:Name="SaveLabel" Text="Guardar" Margin="7,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
