<Window x:Class="Reveal.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reveal · Ajustes" Width="840" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Assets/reveal.ico">
    <!-- Two columns sized to their content: every setting is visible without scrolling. -->
    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ajustes" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Los cambios se guardan al momento." Style="{StaticResource Caption}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconGear}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="General" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Apariencia" FontSize="13" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeCombo" Grid.Column="1" />
                        </Grid>
                        <CheckBox x:Name="StartWithWindows" Margin="0,14,0,0" Content="Iniciar Reveal con Windows" />
                        <CheckBox x:Name="StartCapture" Margin="0,10,0,0" Content="Activar la captura al abrir Reveal" />
                        <CheckBox x:Name="CloseToTray" Margin="0,10,0,0" Content="Al cerrar la ventana, seguir en la bandeja del sistema" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCursor}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="Captura de texto" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <CheckBox x:Name="KeyboardSelection" Margin="0,14,0,0" Content="También con selecciones de teclado (Mayús + flechas)" />
                        <CheckBox x:Name="ClipboardFallback" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Copiar la selección cuando la aplicación no la exponga" FontSize="13" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" />
                                <TextBlock Text="Reveal lee primero la selección mediante accesibilidad (UI Automation). Si una aplicación no lo permite, envía Ctrl+C y restaura tu portapapeles al instante."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSpeaker}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="Tarjeta y voz" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock Text="CERRAR LA TARJETA AUTOMÁTICAMENTE" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                        <ComboBox x:Name="AutoCloseCombo" />
                        <TextBlock Text="VELOCIDAD DE LA VOZ" Style="{StaticResource SectionLabel}" Margin="0,14,0,2" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RateSlider" Minimum="0.6" Maximum="1.4" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                            <TextBlock x:Name="RateText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Text2}" FontSize="12.5" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSwap}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="Traducción" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock x:Name="PackStatus" Style="{StaticResource Body}" FontSize="12.5" Margin="0,10,0,0" />
                        <ProgressBar x:Name="PackProgress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Minimum="0" Maximum="1"
                                     Background="{DynamicResource Bg3}" Foreground="{DynamicResource Accent}" BorderThickness="0" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="PackDownload" Content="Descargar paquete offline" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                            <Button x:Name="PackDelete" Content="Eliminar modelos" Style="{StaticResource BaseButton}" />
                        </WrapPanel>
                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,16,0,14" />
                        <CheckBox x:Name="OnlineFallback">
                            <StackPanel>
                                <TextBlock Text="Permitir traducción en línea si el paquete offline no está disponible" FontSize="13" Foreground="{DynamicResource Text1}" TextWrapping="Wrap" />
                                <TextBlock Text="Usa el punto de acceso público y gratuito de Google Translate. Envía el texto seleccionado a Internet, por eso está desactivado por defecto."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Warning}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Style="{StaticResource CardIcon}" />
                            <TextBlock Text="Privacidad" Style="{StaticResource CardTitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" Margin="0,10,0,0"
                                   Text="Reveal procesa todo en tu equipo: sin cuentas, sin analíticas, sin seguimiento. El texto que seleccionas nunca se escribe en el disco: la tarjeta y la lista «Recientes» solo viven en memoria mientras Reveal está abierto (puedes borrarla), salvo cuando pulsas «Guardar», que añade la palabra a tu documento. La única conexión a Internet es la descarga única de los modelos de traducción y, si tú lo activas, la traducción en línea opcional." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Acerca de" Style="{StaticResource CardTitle}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="AboutText" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,12,0" />
                        </StackPanel>
                        <Button x:Name="OpenLogs" Grid.Column="1" Content="Registros" Style="{StaticResource BaseButton}" VerticalAlignment="Center"
                                ToolTip="Abrir carpeta de registros" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
