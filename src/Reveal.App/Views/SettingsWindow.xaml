<Window x:Class="Reveal.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reveal · Ajustes" Width="520" Height="700" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        Icon="pack://application:,,,/Assets/reveal.ico">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,26">
            <TextBlock Text="Ajustes" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />

            <!-- General -->
            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" />
                    <CheckBox x:Name="StartWithWindows" Margin="0,14,0,0" Content="Iniciar Reveal con Windows" />
                    <CheckBox x:Name="StartCapture" Margin="0,12,0,0" Content="Activar la captura al abrir Reveal" />
                    <CheckBox x:Name="CloseToTray" Margin="0,12,0,0" Content="Al cerrar la ventana, seguir en la bandeja del sistema" />
                </StackPanel>
            </Border>

            <!-- Capture -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Captura de texto" FontSize="15" FontWeight="SemiBold" />
                    <CheckBox x:Name="KeyboardSelection" Margin="0,14,0,0" Content="También con selecciones de teclado (Mayús + flechas)" />
                    <CheckBox x:Name="ClipboardFallback" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Copiar la selección cuando la aplicación no la exponga" FontSize="13" Foreground="{StaticResource Text1}" TextWrapping="Wrap" />
                            <TextBlock Text="Reveal lee primero la selección mediante accesibilidad (UI Automation). Si una aplicación no lo permite, envía Ctrl+C y restaura tu portapapeles al instante."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Translation -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Traducción" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="PackStatus" Style="{StaticResource Body}" Margin="0,6,0,0" />
                    <ProgressBar x:Name="PackProgress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Minimum="0" Maximum="1"
                                 Background="{StaticResource Bg3}" Foreground="{StaticResource Accent}" BorderThickness="0" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button x:Name="PackDownload" Content="Descargar paquete offline" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button x:Name="PackDelete" Content="Eliminar modelos" Style="{StaticResource BaseButton}" />
                    </WrapPanel>
                    <CheckBox x:Name="OnlineFallback" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Permitir traducción en línea si el paquete offline no está disponible" FontSize="13" Foreground="{StaticResource Text1}" TextWrapping="Wrap" />
                            <TextBlock Text="Usa el punto de acceso público y gratuito de Google Translate. Envía el texto seleccionado a Internet, por eso está desactivado por defecto."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{StaticResource Warning}" />
                        </StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Overlay & speech -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Tarjeta y voz" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="CERRAR LA TARJETA AUTOMÁTICAMENTE" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" />
                    <ComboBox x:Name="AutoCloseCombo" />
                    <TextBlock Text="VELOCIDAD DE LA VOZ" Style="{StaticResource SectionLabel}" Margin="0,16,0,2" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="RateSlider" Minimum="0.6" Maximum="1.4" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                        <TextBlock x:Name="RateText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Text2}" FontSize="12.5" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Privacidad" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="Reveal procesa todo en tu equipo: sin cuentas, sin analíticas, sin seguimiento. El texto que seleccionas no se guarda (solo vive en memoria mientras ves la tarjeta) salvo cuando pulsas «Guardar», que lo añade a tu documento. La única conexión a Internet es la descarga única de los modelos de traducción y, si tú lo activas, la traducción en línea opcional." />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Acerca de" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="AboutText" Style="{StaticResource Body}" Margin="0,6,0,0" />
                    <Button x:Name="OpenLogs" Content="Abrir carpeta de registros" Style="{StaticResource BaseButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
