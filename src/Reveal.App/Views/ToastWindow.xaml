<Window x:Class="Reveal.App.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reveal" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" UseLayoutRounding="True" SnapsToDevicePixels="True" IsHitTestVisible="False">
    <Grid Margin="28">
        <Border x:Name="Pill" Background="#FC111317" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="14" Padding="16,11,18,11">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="DotMark" Width="9" Height="9" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,1,11,0" />
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text1}" />
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource Text3}" Margin="0,2,0,0" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
